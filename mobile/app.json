{
  "expo": {
    "name": "LABOURLY",
    "slug": "nammacrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/labourly/launcher-white.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.nammacrew.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/labourly/hardhat-mark.png",
        "monochromeImage": "./assets/labourly/hardhat-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.nammacrew.mobile"
    },
    "web": {
      "favicon": "./assets/labourly/launcher-white.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "locationWhenInUsePermission": "Allow Labourly to use your location to find workers near you.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withLabourlyLaunch"
    ],
    "scheme": "nammacrew"
  }
}
